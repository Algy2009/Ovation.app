{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@ovation/shared": ["../../packages/shared/src/index.ts"],
      "@ovation/validation": ["../../packages/validation/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
