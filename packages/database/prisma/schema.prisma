// ==============================================================================
// PRISMA SCHEMA - OVATION CONCERT TICKETING PLATFORM
// Enterprise-Grade Relational Schema for High-Concurrency Ticketing
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ORGANIZER
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum OrganizerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum EventStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAYMENT_PROCESSING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  MIDTRANS
}

enum PaymentChannel {
  QRIS
  VIRTUAL_ACCOUNT
  EWALLET
  CREDIT_CARD
  RETAIL_OUTLET
}

enum PaymentStatus {
  PENDING
  CHALLENGE
  SETTLEMENT
  CAPTURE
  DENY
  EXPIRE
  CANCEL
  REFUND
}

enum RefundStatus {
  REQUESTED
  ORGANIZER_APPROVED
  SUPERADMIN_APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

enum SettlementStatus {
  PENDING
  APPROVED
  TRANSFERRED
  REJECTED
}

enum QueueStatus {
  WAITING
  ADMITTED
  EXPIRED
  CANCELLED
}

enum ScanResult {
  SUCCESS
  ALREADY_CHECKED_IN
  INVALID_TOKEN
  EXPIRED_TOKEN
  EVENT_NOT_ACTIVE
}

enum NotificationType {
  PAYMENT_PENDING
  PAYMENT_SUCCESS
  PAYMENT_EXPIRED
  REFUND_UPDATE
  EVENT_UPDATE
  QUEUE_ADMITTED
  SECURITY_ALERT
}

// ------------------------------------------------------------------------------
// 1. USERS
// ------------------------------------------------------------------------------
model User {
  id                   String        @id @default(cuid())
  email                String        @unique
  passwordHash         String        @map("password_hash")
  name                 String
  phone                String?
  isPhoneVerified      Boolean       @default(false) @map("is_phone_verified")
  nikEncrypted         String?       @map("nik_encrypted") @db.Text
  nikLast4             String?       @map("nik_last4")
  role                 UserRole      @default(CUSTOMER)
  status               UserStatus    @default(ACTIVE)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  // Relations
  organizerProfile     Organizer?
  orders               Order[]
  wishlists            Wishlist[]
  virtualQueues        VirtualQueue[]
  refundRequests       RefundRequest[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  scannedCheckins      CheckinLog[]

  @@index([role])
  @@index([status])
  @@index([email])
  @@index([phone])
  @@map("users")
}

// ------------------------------------------------------------------------------
// 2. ORGANIZERS (Promoters)
// ------------------------------------------------------------------------------
model Organizer {
  id                   String           @id @default(cuid())
  userId               String           @unique @map("user_id")
  companyName          String           @map("company_name")
  brandName            String           @map("brand_name")
  email                String
  phone                String
  address              String?          @db.Text
  bankName             String           @map("bank_name")
  bankAccountNumber    String           @map("bank_account_number")
  bankAccountHolder    String           @map("bank_account_holder")
  npwp                 String?
  legalDocumentUrl     String?          @map("legal_document_url") @db.Text
  verificationStatus   OrganizerStatus  @default(PENDING) @map("verification_status")
  feePercentage        Decimal          @default(5.00) @map("fee_percentage") @db.Decimal(5, 2)
  verifiedAt           DateTime?        @map("verified_at")
  verifiedByUserId     String?          @map("verified_by_user_id")
  rejectionReason      String?          @map("rejection_reason") @db.Text
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  // Relations
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events               Event[]
  settlements          Settlement[]

  @@index([verificationStatus])
  @@index([brandName])
  @@map("organizers")
}

// ------------------------------------------------------------------------------
// 3. EVENT CATEGORIES
// ------------------------------------------------------------------------------
model EventCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  events      Event[]

  @@map("event_categories")
}

// ------------------------------------------------------------------------------
// 4. EVENTS
// ------------------------------------------------------------------------------
model Event {
  id                       String          @id @default(cuid())
  organizerId              String          @map("organizer_id")
  categoryId               String          @map("category_id")
  title                    String
  slug                     String          @unique
  description              String          @db.Text
  termsAndConditions       String?         @map("terms_and_conditions") @db.Text
  bannerUrl                String          @map("banner_url") @db.Text
  venueName                String          @map("venue_name")
  venueCity                String          @map("venue_city")
  address                  String          @db.Text
  startDatetime            DateTime        @map("start_datetime")
  endDatetime              DateTime        @map("end_datetime")
  status                   EventStatus     @default(DRAFT)
  isFeatured               Boolean         @default(false) @map("is_featured")
  warTicketActive          Boolean         @default(false) @map("war_ticket_active")
  warTicketStartTime       DateTime?       @map("war_ticket_start_time")
  maxTicketsPerNik         Int             @default(4) @map("max_tickets_per_nik")
  maxTicketsPerTransaction Int             @default(4) @map("max_tickets_per_transaction")
  platformFeePercent       Decimal         @default(5.00) @map("platform_fee_percent") @db.Decimal(5, 2)
  adminFeeFixed            Decimal         @default(5000.00) @map("admin_fee_fixed") @db.Decimal(12, 2)
  approvedAt               DateTime?       @map("approved_at")
  approvedByUserId         String?         @map("approved_by_user_id")
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")

  // Relations
  organizer                Organizer       @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  category                 EventCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  ticketCategories         TicketCategory[]
  orders                   Order[]
  wishlists                Wishlist[]
  virtualQueues            VirtualQueue[]
  settlements              Settlement[]

  @@index([status])
  @@index([venueCity])
  @@index([startDatetime])
  @@index([isFeatured])
  @@index([warTicketActive])
  @@map("events")
}

// ------------------------------------------------------------------------------
// 5. TICKET CATEGORIES
// ------------------------------------------------------------------------------
model TicketCategory {
  id                   String      @id @default(cuid())
  eventId              String      @map("event_id")
  name                 String
  description          String?     @db.Text
  price                Decimal     @db.Decimal(12, 2)
  totalQuota           Int         @map("total_quota")
  remainingQuota       Int         @map("remaining_quota")
  maxPerTransaction    Int         @default(4) @map("max_per_transaction")
  isVirtualQueueEnabled Boolean    @default(false) @map("is_virtual_queue_enabled")
  salesStartTime       DateTime    @map("sales_start_time")
  salesEndTime         DateTime    @map("sales_end_time")
  isStanding           Boolean     @default(false) @map("is_standing")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  // Relations
  event                Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems           OrderItem[]

  @@index([eventId])
  @@index([remainingQuota])
  @@index([price])
  @@map("ticket_categories")
}

// ------------------------------------------------------------------------------
// 6. ORDERS
// ------------------------------------------------------------------------------
model Order {
  id                   String          @id @default(cuid())
  orderNumber          String          @unique @map("order_number")
  userId               String          @map("user_id")
  eventId              String          @map("event_id")
  totalQuantity        Int             @map("total_quantity")
  subtotal             Decimal         @db.Decimal(14, 2)
  platformFee          Decimal         @map("platform_fee") @db.Decimal(14, 2)
  adminFee             Decimal         @map("admin_fee") @db.Decimal(14, 2)
  finalAmount          Decimal         @map("final_amount") @db.Decimal(14, 2)
  status               OrderStatus     @default(PENDING)
  paymentMethod        String?         @map("payment_method")
  expiredAt            DateTime        @map("expired_at")
  paidAt               DateTime?       @map("paid_at")
  cancelledAt          DateTime?       @map("cancelled_at")
  idempotencyKey       String?         @unique @map("idempotency_key")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  // Relations
  user                 User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  event                Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items                OrderItem[]
  payments             Payment[]
  refundRequests       RefundRequest[]

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([expiredAt])
  @@index([orderNumber])
  @@map("orders")
}

// ------------------------------------------------------------------------------
// 7. ORDER ITEMS
// ------------------------------------------------------------------------------
model OrderItem {
  id                   String          @id @default(cuid())
  orderId              String          @map("order_id")
  ticketCategoryId     String          @map("ticket_category_id")
  quantity             Int
  unitPrice            Decimal         @map("unit_price") @db.Decimal(12, 2)
  subtotal             Decimal         @db.Decimal(12, 2)
  createdAt            DateTime        @default(now()) @map("created_at")

  // Relations
  order                Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketCategory       TicketCategory  @relation(fields: [ticketCategoryId], references: [id], onDelete: Restrict)
  issuedTickets        IssuedTicket[]

  @@index([orderId])
  @@index([ticketCategoryId])
  @@map("order_items")
}

// ------------------------------------------------------------------------------
// 8. ISSUED TICKETS
// ------------------------------------------------------------------------------
model IssuedTicket {
  id                   String        @id @default(cuid())
  orderItemId          String        @map("order_item_id")
  ticketCode           String        @unique @map("ticket_code")
  attendeeName         String        @map("attendee_name")
  attendeeEmail        String        @map("attendee_email")
  attendeePhone        String?       @map("attendee_phone")
  attendeeNikEncrypted String        @map("attendee_nik_encrypted") @db.Text
  attendeeNikLast4     String        @map("attendee_nik_last4")
  dynamicHmacSecret    String        @map("dynamic_hmac_secret")
  isCheckedIn          Boolean       @default(false) @map("is_checked_in")
  checkedInAt          DateTime?     @map("checked_in_at")
  checkedInGate        String?       @map("checked_in_gate")
  checkedInByUserId    String?       @map("checked_in_by_user_id")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  // Relations
  orderItem            OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  checkinLogs          CheckinLog[]

  @@index([ticketCode])
  @@index([isCheckedIn])
  @@index([attendeeNikLast4])
  @@map("issued_tickets")
}

// ------------------------------------------------------------------------------
// 9. PAYMENTS
// ------------------------------------------------------------------------------
model Payment {
  id                   String          @id @default(cuid())
  orderId              String          @map("order_id")
  provider             PaymentProvider
  channel              PaymentChannel
  paymentMethodDetail  String?         @map("payment_method_detail")
  referenceId          String          @unique @map("reference_id")
  merchantOrderId      String          @map("merchant_order_id")
  paymentUrl           String?         @map("payment_url") @db.Text
  vaNumber             String?         @map("va_number")
  qrString             String?         @map("qr_string") @db.Text
  deepLinkUrl          String?         @map("deep_link_url") @db.Text
  amount               Decimal         @db.Decimal(14, 2)
  status               PaymentStatus   @default(PENDING)
  rawResponse          String?         @map("raw_response") @db.Text
  paidAt               DateTime?       @map("paid_at")
  expiredAt            DateTime        @map("expired_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  // Relations
  order                Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([provider])
  @@index([referenceId])
  @@index([status])
  @@map("payments")
}

// ------------------------------------------------------------------------------
// 10. PAYMENT WEBHOOK LOGS
// ------------------------------------------------------------------------------
model PaymentWebhookLog {
  id                   String          @id @default(cuid())
  provider             PaymentProvider
  referenceId          String?         @map("reference_id")
  orderNumber          String?         @map("order_number")
  eventType            String          @map("event_type")
  signatureValid       Boolean         @map("signature_valid")
  idempotencyHash      String          @unique @map("idempotency_hash")
  rawPayload           String          @map("raw_payload") @db.Text
  processed            Boolean         @default(false)
  processedAt          DateTime?       @map("processed_at")
  processingError      String?         @map("processing_error") @db.Text
  ipAddress            String?         @map("ip_address")
  createdAt            DateTime        @default(now()) @map("created_at")

  @@index([provider])
  @@index([referenceId])
  @@index([orderNumber])
  @@index([processed])
  @@map("payment_webhook_logs")
}

// ------------------------------------------------------------------------------
// 11. REFUND REQUESTS
// ------------------------------------------------------------------------------
model RefundRequest {
  id                   String        @id @default(cuid())
  orderId              String        @map("order_id")
  userId               String        @map("user_id")
  reason               String        @db.Text
  refundAmount         Decimal       @map("refund_amount") @db.Decimal(14, 2)
  bankName             String        @map("bank_name")
  bankAccountNumber    String        @map("bank_account_number")
  bankAccountHolder    String        @map("bank_account_holder")
  status               RefundStatus  @default(REQUESTED)
  rejectionReason      String?       @map("rejection_reason") @db.Text
  reviewedByOrganizerId String?      @map("reviewed_by_organizer_id")
  reviewedByOrganizerAt DateTime?    @map("reviewed_by_organizer_at")
  approvedBySuperAdminId String?     @map("approved_by_superadmin_id")
  approvedBySuperAdminAt DateTime?   @map("approved_by_superadmin_at")
  providerRefundId     String?       @map("provider_refund_id")
  completedAt          DateTime?     @map("completed_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  // Relations
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user                 User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@map("refund_requests")
}

// ------------------------------------------------------------------------------
// 12. SETTLEMENTS
// ------------------------------------------------------------------------------
model Settlement {
  id                   String           @id @default(cuid())
  settlementNumber     String           @unique @map("settlement_number")
  organizerId          String           @map("organizer_id")
  eventId              String           @map("event_id")
  totalGrossSales      Decimal          @map("total_gross_sales") @db.Decimal(14, 2)
  totalPlatformFee     Decimal          @map("total_platform_fee") @db.Decimal(14, 2)
  totalAdminFee        Decimal          @map("total_admin_fee") @db.Decimal(14, 2)
  totalRefundedAmount  Decimal          @default(0.00) @map("total_refunded_amount") @db.Decimal(14, 2)
  netPayoutAmount      Decimal          @map("net_payout_amount") @db.Decimal(14, 2)
  status               SettlementStatus @default(PENDING)
  transferReference    String?          @map("transfer_reference")
  transferReceiptUrl   String?          @map("transfer_receipt_url") @db.Text
  approvedByUserId     String?          @map("approved_by_user_id")
  transferredAt        DateTime?        @map("transferred_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  // Relations
  organizer            Organizer        @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  event                Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([organizerId])
  @@index([eventId])
  @@index([status])
  @@map("settlements")
}

// ------------------------------------------------------------------------------
// 13. AUDIT LOGS
// ------------------------------------------------------------------------------
model AuditLog {
  id                   String    @id @default(cuid())
  actorId              String?   @map("actor_id")
  actorRole            String?   @map("actor_role")
  action               String
  entityName           String    @map("entity_name")
  entityId             String    @map("entity_id")
  oldValues            String?   @map("old_values") @db.Text
  newValues            String?   @map("new_values") @db.Text
  ipAddress            String?   @map("ip_address")
  userAgent            String?   @map("user_agent") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")

  // Relations
  actor                User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityName])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// 14. WISHLISTS
// ------------------------------------------------------------------------------
model Wishlist {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  eventId              String    @map("event_id")
  createdAt            DateTime  @default(now()) @map("created_at")

  // Relations
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event                Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("wishlists")
}

// ------------------------------------------------------------------------------
// 15. VIRTUAL QUEUES
// ------------------------------------------------------------------------------
model VirtualQueue {
  id                   String      @id @default(cuid())
  eventId              String      @map("event_id")
  userId               String      @map("user_id")
  queueToken           String      @unique @map("queue_token")
  queueNumber          Int         @map("queue_number")
  status               QueueStatus @default(WAITING)
  ipAddress            String?     @map("ip_address")
  userAgent            String?     @map("user_agent") @db.Text
  joinedAt             DateTime    @default(now()) @map("joined_at")
  admittedAt           DateTime?   @map("admitted_at")
  expiresAt            DateTime?   @map("expires_at")

  // Relations
  event                Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
  @@index([status])
  @@index([queueNumber])
  @@map("virtual_queues")
}

// ------------------------------------------------------------------------------
// 16. CHECKIN LOGS
// ------------------------------------------------------------------------------
model CheckinLog {
  id                   String        @id @default(cuid())
  issuedTicketId       String        @map("issued_ticket_id")
  scannedByUserId      String        @map("scanned_by_user_id")
  gateName             String        @map("gate_name")
  scanResult           ScanResult    @map("scan_result")
  rejectionReason      String?       @map("rejection_reason")
  dynamicTokenProvided String?       @map("dynamic_token_provided")
  ipAddress            String?       @map("ip_address")
  scannedAt            DateTime      @default(now()) @map("scanned_at")

  // Relations
  issuedTicket         IssuedTicket  @relation(fields: [issuedTicketId], references: [id], onDelete: Cascade)
  scannedBy            User          @relation(fields: [scannedByUserId], references: [id], onDelete: Restrict)

  @@index([issuedTicketId])
  @@index([scannedByUserId])
  @@index([scanResult])
  @@index([scannedAt])
  @@map("checkin_logs")
}

// ------------------------------------------------------------------------------
// 17. NOTIFICATIONS
// ------------------------------------------------------------------------------
model Notification {
  id                   String           @id @default(cuid())
  userId               String           @map("user_id")
  title                String
  message              String           @db.Text
  type                 NotificationType
  isRead               Boolean          @default(false) @map("is_read")
  linkUrl              String?          @map("link_url")
  createdAt            DateTime         @default(now()) @map("created_at")

  // Relations
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}
